{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackery",
  "version": "0.1.0",
  "identifier": "fi.trackery.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Trackery — private finance tracker",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
